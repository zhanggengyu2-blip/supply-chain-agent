# 忽略规则说明见 https://help.github.com/articles/ignoring-files/。

# 依赖文件
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试覆盖率报告
/coverage

# Next.js 构建与导出目录
/.next/
/out/

# 生产构建目录
/build

# 系统文件与证书
.DS_Store
*.pem

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 环境变量文件（必要时可显式纳入版本控制）
.env*

# Vercel 部署配置
.vercel

# TypeScript 生成的文件
*.tsbuildinfo
next-env.d.ts
