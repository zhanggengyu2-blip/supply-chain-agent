# DeepSeek API Key（主对话、grader、联网搜索共用）
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# 可选：不填则使用 deepseek-flash；需使用 DeepSeek Responses API 的 web_search
WEB_SEARCH_MODEL=deepseek-flash
DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB_NAME=supply_chain_agent
# ERPNext: dedicated least-privilege read user, never Administrator.
ERPNEXT_BASE_URL=http://127.0.0.1:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_API_USER=
ERPNEXT_COMPANY=
# Comma-separated full Warehouse.name values, not warehouse_name.
ERPNEXT_WAREHOUSES=
MCP_SERVER_URL=http://127.0.0.1:9000
# Phase one execution tools are disabled unconditionally.
MCP_HOST=127.0.0.1
MCP_PORT=9000

# Optional metadata-only Langfuse tracing (no business payloads).
ERP_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
ERP_TRACE_HASH_KEY=
ERP_TRACE_ENVIRONMENT=development
ERP_TRACE_RELEASE=erpnext-phase1

# ===== 三层记忆（HOT / WARM / COLD，均可不配，走默认值）=====
# 情节记忆在 WARM 层停留天数，超过后只在 COLD 按需检索
MEMORY_WARM_EPISODE_DAYS=7
# 情节记忆保留天数，过期后被遗忘（硬删除）
MEMORY_EPISODE_TTL_DAYS=90
# COLD 层单次检索返回条数
MEMORY_RETRIEVAL_K=5
# 每位用户最多保留的情节条数
MEMORY_MAX_EPISODES=200
# 是否向 Agent 暴露 read_memory / remember 工具
MEMORY_TOOLS_ENABLED=true
# 是否启用 LLM 抽取偏好（默认关闭，走零成本确定性规则）
MEMORY_LLM_EXTRACTION=false
# 审查路由：默认保留 DeepSeek；可选 jev（独立于主 Agent / Grader）
REVIEW_ROUTER_PROVIDER=deepseek
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
